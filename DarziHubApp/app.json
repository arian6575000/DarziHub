{
  "expo": {
    "name": "DarziHub",
    "slug": "darzihub",
    "scheme": "darzihub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#eef1f8"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.darzihub.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Pick design / fabric photos for orders and your shop logo.",
        "NSCameraUsageDescription": "Take design / fabric photos for orders."
      }
    },
    "android": {
      "package": "com.darzihub.app",
      "adaptiveIcon": {
        "backgroundColor": "#3E6BFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-localization",
        {
          "supportsRTL": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3E6BFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick design / fabric photos for orders and your shop logo.",
          "cameraPermission": "Take design / fabric photos for orders."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}